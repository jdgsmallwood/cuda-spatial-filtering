{
  "uid": "starspin-monitor",
  "title": "Starspin \u2014 live quality and server health",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "editable": false,
  "tags": [
    "Starspin"
  ],
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "redis-datasource",
          "uid": "starspin-redis"
        },
        "query": "GET starspin:latest",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "input",
        "label": "Input",
        "type": "query",
        "datasource": {
          "type": "redis-datasource",
          "uid": "starspin-redis"
        },
        "query": "SMEMBERS starspin:$run:inputs",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "baseline",
        "label": "Baseline",
        "type": "query",
        "datasource": {
          "type": "redis-datasource",
          "uid": "starspin-redis"
        },
        "query": "SMEMBERS starspin:$run:baselines",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Last monitor update \u2014 stale after 15 s at the default cadence",
      "type": "stat",
      "datasource": {
        "type": "redis-datasource",
        "uid": "starspin-redis"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "type": "timeSeries",
          "command": "ts.range",
          "keyName": "starspin:$run:heartbeat_ms",
          "legend": "heartbeat_ms",
          "value": "heartbeat_ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "textMode": "value"
      },
      "transformations": [],
      "pluginVersion": "12.2.1"
    },
    {
