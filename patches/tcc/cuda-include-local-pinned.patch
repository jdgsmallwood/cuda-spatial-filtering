--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -23,6 +23,18 @@ endif()
 
 find_package(CUDAToolkit REQUIRED)
 
+# CMake knows the header location even when libnvrtc lives elsewhere.
+set(TCC_CUDA_INCLUDE_DIR)
+foreach(_cuda_inc_dir IN LISTS CUDAToolkit_INCLUDE_DIRS)
+  if(EXISTS "${_cuda_inc_dir}/cuda.h")
+    set(TCC_CUDA_INCLUDE_DIR "${_cuda_inc_dir}")
+    break()
+  endif()
+endforeach()
+if(NOT TCC_CUDA_INCLUDE_DIR)
+  message(WARNING "Could not locate cuda.h in CUDAToolkit_INCLUDE_DIRS; NVRTC will fall back on runtime auto-detection")
+endif()
+
